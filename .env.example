# =====================================================================
# Block-7 暮谷镇 · 环境变量模板
# 复制为 .env(同目录,与项目根平级)后填入真实值
# =====================================================================

# --- DeepSeek API(必填)---
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash

# --- 后端服务 ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- 数据库 + 日志(相对路径会基于项目根解析)---
SQLITE_PATH=./backend/data/sim.db
LOG_LEVEL=INFO
LOG_DIR=./logs

# =====================================================================
# Sim 行为 / 成本控制(BLOCK7_*)— 全部可选,有合理默认
# =====================================================================

# 启动时 tick 循环是否暂停。1 = paused 启动(默认,零成本,等 Godot 点 ▶)
# 0 = 立即运行(自动烧 token,加速测试时用)
# BLOCK7_START_PAUSED=1

# tick 循环是否启动。1 = 自动 tick(默认)
# 0 = 只注册 12 agent 不 tick(纯调试 Godot 端时用,完全零成本)
# BLOCK7_AUTO_TICK=1

# 1 现实秒 = N 游戏秒。默认 60(1 现实分钟 = 1 游戏小时)
# 加速调试 Block G 跨日反思时设 3600(1 现实秒 = 1 游戏小时,24 秒跨日)
# BLOCK7_TIME_SCALE=60

# tick 循环间隔(现实秒)。默认 1.0
# BLOCK7_TICK_INTERVAL=1.0

# scheduler 阈值:agent 队列剩余游戏秒 < 此值时触发新一轮 fine plan thinking
# 默认 120 — 降低则更频繁产 action 但烧更多 token
# BLOCK7_THINKING_THRESHOLD=120

# 每次 fine plan LLM 输出 action 数上限。默认 15
# BLOCK7_MAX_ACTIONS=15

# 跨游戏日是否自动反思 + 压缩(Block G)。1 = 开(默认)
# 0 = 关(纯调试 fine plan 时,避免 reflection 占满 LLM)
# BLOCK7_DAILY_REFLECTION=1
